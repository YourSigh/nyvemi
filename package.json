{
  "name": "nyvemi",
  "description": "Android-first local-first AI companion",
  "license": "AGPL-3.0-only",
  "version": "0.14.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "android:build": "cd android && NODE_ENV=development ./gradlew assembleDebug",
    "android:release": "cd android && NODE_ENV=production ./gradlew assembleRelease",
    "format": "prettier --write App.tsx index.ts 'src/**/*.{ts,tsx}' 'tests/**/*.ts' 'plugins/*.js' 'scripts/*.cjs' eslint.config.js vitest.config.mts '*.json' '*.md' 'docs/*.md' ",
    "format:check": "prettier --check App.tsx index.ts 'src/**/*.{ts,tsx}' 'tests/**/*.ts' 'plugins/*.js' 'scripts/*.cjs' eslint.config.js vitest.config.mts '*.json' '*.md' 'docs/*.md' ",
    "verify": "bash scripts/verify.sh",
    "prebuild:android": "expo prebuild --platform android",
    "test:live": "node scripts/test-live.cjs",
    "test:live:images": "node scripts/test-live-images.cjs",
    "avatar:setup": "node scripts/vtuber/setup.cjs",
    "avatar:candidates": "node scripts/vtuber/artwork.cjs candidates",
    "avatar:split": "node scripts/vtuber/artwork.cjs split",
    "avatar:rig": "node scripts/vtuber/rig.cjs",
    "avatar:bundle": "node scripts/vtuber/bundle-player.cjs",
    "agent:bundle": "node scripts/dsh/bundle.cjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-background-task": "~55.0.22",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image-picker": "~55.0.24",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "fast-xml-parser": "^5.9.3",
    "fflate": "^0.8.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@noble/hashes": "2.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "ag-psd": "^33.0.0",
    "buffer": "6.0.3",
    "dsh-zod": "npm:zod@4.4.3",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~55.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
