{
  "expo": {
    "name": "Nyvemi",
    "slug": "nyvemi",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/nyvemi-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/nyvemi-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7FA"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7FA",
        "foregroundImage": "./assets/nyvemi-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nyvemi.android",
      "allowBackup": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "versionCode": 12
    },
    "scheme": "nyvemi",
    "platforms": ["android"],
    "plugins": [
      "expo-dev-client",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-background-task",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "./plugins/withNyvemiAndroid",
      "expo-asset"
    ],
    "primaryColor": "#B94776"
  }
}
