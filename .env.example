# 仅供本机 Node 测试，不会打进 Android App。不要加 EXPO_PUBLIC_ 前缀。
NYVEMI_TEST_API_KEY=
NYVEMI_TEST_BASE_URL=https://api.deepseek.com
NYVEMI_TEST_MODEL=deepseek-flash

# 豆包 / 火山方舟：仅供本机付费接口测试。App 内另用 Keystore 配置。
NYVEMI_ARK_API_KEY=
NYVEMI_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
NYVEMI_ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
NYVEMI_ARK_LAYER_MODEL=doubao-seedream-5-0-pro-260628
# 默认禁止真实调用；显式开启后才运行，拆层可能按多张图计费。
NYVEMI_ARK_ENABLE_LIVE_TESTS=0
NYVEMI_ARK_LIVE_MAX_REQUESTS=2
